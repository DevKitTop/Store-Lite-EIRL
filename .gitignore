# NOTE: keep *.txt files tracked by default. If you previously ignored a specific
# .txt file (e.g. `tasks.txt`) and want it tracked, remove it from this list.
*.txt

# Sentry Config File
.env.sentry-build-plugin

# AI debug/dump files (transcript recovery, pattern dumps, etc.)
dump.*
found.*
raw_*
recover.*
recovered_*
search_history.*

# IDE & MCP Meta
.mcp.json
opencode.json

# --------------------------------------------------
# Ignore Markdown files by default but allow a short whitelist
# (use this to avoid committing auto-generated analysis files)
*.md
!README.md
!SOUL.md
!AGENTS.md

# Capability specs are the source of truth and MUST be versioned.
# Without this, a fresh clone silently misses every requirement that was
# archived while this blanket rule was in effect (gitignore only applies to
# untracked files, so specs committed before the rule were unaffected).
# Scope: openspec/specs/ only. openspec/changes/ stays ignored so in-flight
# change folders (proposal/design/tasks, local-only drafts) never leak into commits.
!openspec/specs/**/*.md

# Explicitly ignore analysis files created in the workspace
informe_detallado_archivos_grandes.md
tareas_prs_prioritizadas.md

# If you prefer an alternate naming convention for local notes, consider
# using a suffix not matching .md (e.g. .task or .private) and add patterns
# here as needed.
.env.local
send-test-email.ts
.env.current

sendTestEmail.ts
