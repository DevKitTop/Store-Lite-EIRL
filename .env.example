# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Default publishable/secret keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx
SUPABASE_SECRET_DEFAULT_KEY=sb_secret_xxx

# Database
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres

# Raw DB values
DB_HOST=db.project.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USER=postgres

# Sentry
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta Pixel + Conversions API (CAPI) — consent-gated advertising tracking
# NEXT_PUBLIC_META_PIXEL_ID: public, used by the browser pixel
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
# META_CAPI_ACCESS_TOKEN: server-only, NEVER expose to the client
META_CAPI_ACCESS_TOKEN=your-meta-capi-access-token
# META_TEST_EVENT_CODE: optional, for validating events in Meta Events Manager
META_TEST_EVENT_CODE=

# Culqi
NEXT_PUBLIC_CULQI_PK=pk_test_xxx
CULQI_SK=sk_test_xxx
# Cuando CULQI_ENFORCE_LIVE_KEYS=true, solo se aceptan llaves _live al configurar
# (útil en producción para evitar que un seller ponga keys de prueba).
# En desarrollo dejarlo false o comentado.
CULQI_ENFORCE_LIVE_KEYS=false
# CulqiPanel webhook credentials (basic auth)
CULQI_WEBHOOK_USER=your-webhook-user
CULQI_WEBHOOK_PASS=your-webhook-password

# JSON.pe API (RUC, DNI, representantes)
JSON_TOKEN=your-jsonpe-token

# Twilio WhatsApp OTP (Official Meta Cloud API)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SERVICE_SID=your-twilio-service-sid

# OTP Hashing (HMAC secret for OTPs)
OTP_HASH_SECRET=replace-with-a-strong-random-secret

# Feature Flags
FEATURE_SUBDOMAIN_REWRITE=false
ORDER_FLOW_V2=true

# Cookie Domain (subdominios)
# Producción: SHARED_COOKIE_DOMAIN=.storelite.app
# Desarrollo: SHARED_COOKIE_DOMAIN=.localhost
SHARED_COOKIE_DOMAIN=

# Customer Auth Popup - central domain
# En producción: https://storelite.app
# En desarrollo: http://localhost:3000
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost:3000

# Main application domain for settings URL display
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
# Full app URL (used by robots.txt, sitemap, canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron
VERCEL_CRON_DISABLE=false

# JSON.pe SMS — order notifications to customers
JSONPE_SMS_TOKEN=your-jsonpe-sms-token

# Resend — transactional emails (Server-side only)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL="Store Lite" <notificaciones@yourdomain.com>

# SASS Notification Broadcast
SASS_API_KEY=your-sass-api-key

# CRON_SECRET (protects cron endpoints)
CRON_SECRET=your-cron-secret

# YCloud + Facebook Embedded Signup (WhatsApp Business App coexistence)
# Public Meta partner config, consumed client-side by the coexistence popup.
# Unset → the pair-code modal stays as fallback. Requires the dashboard
# domain in Meta's Allowed Domains / Valid OAuth Redirect URIs.
NEXT_PUBLIC_YCLOUD_FB_APP_ID=your-meta-app-id
NEXT_PUBLIC_YCLOUD_FB_CONFIG_ID=your-embedded-signup-config-id
NEXT_PUBLIC_YCLOUD_FB_SOLUTION_ID=your-solution-id
